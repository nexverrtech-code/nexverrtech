# NEXVERR TECHNOLOGIES — frontend configuration
# Copy to `.env` and fill in the real values before deploying.
# These are PUBLIC values baked into the client bundle. Never put secrets here.

# WhatsApp number in full international format, digits only (country code + number).
# Example format: 91XXXXXXXXXX
VITE_WHATSAPP_NUMBER=

# Inbox that should receive project inquiries.
VITE_CONTACT_EMAIL=

# Optional. Display/dial number, e.g. +91 99999 99999.
# Leave blank and the phone row is hidden rather than rendered empty.
VITE_CONTACT_PHONE=

# Canonical site origin, no trailing slash. Used for canonical + OpenGraph URLs.
VITE_SITE_URL=https://nexverrtech.com

# Optional. Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Blank means no analytics script is loaded at all — no tag, no cookies.
VITE_GA_MEASUREMENT_ID=
